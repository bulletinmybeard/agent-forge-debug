{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentForge Debug",
  "version": "0.1.0",
  "identifier": "com.agentforge.debug",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentForge Debug",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost ws: wss:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost ws: wss: http://localhost:1420 ws://localhost:1421 http://localhost:1421",
        "img-src": "'self' data: http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420",
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Session inspector for AgentForge.",
    "longDescription": "AgentForge Debug is a native macOS inspector for chat sessions, audit records, and Loki logs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
